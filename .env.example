# Database Configuration
# For production with PostgreSQL (Vercel, Neon, Supabase)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# For local development with SQLite (not compatible with Vercel)
# DATABASE_URL="file:./dev.db"

# For Vercel Postgres (automatically set by Vercel)
# POSTGRES_URL="postgres://..."
# POSTGRES_PRISMA_URL="postgres://..."
# POSTGRES_URL_NON_POOLING="postgres://..."

# Node Environment
NODE_ENV="development"

# Optional: Add your custom environment variables below
# NEXT_PUBLIC_APP_NAME="MOUNT+PLUS"
# NEXT_PUBLIC_COMPANY_NAME="Your Company Name"
